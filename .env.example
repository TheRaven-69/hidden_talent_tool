# Copy to .env (gitignored). Endpoints and deployment names only. NO secrets:
# auth uses DefaultAzureCredential (`az login` locally, managed identity in Azure).
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION=""
CHAT_DEPLOYMENT=""
EMBEDDING_DEPLOYMENT=""

SEARCH_ENDPOINT=""
TAXONOMY_INDEX=""
JOBS_INDEX=""
# Fill in after verifying the indexes (README section 5)
# Real index fields: taxonomy = id, text, vector, preferred_label, type, definition, alternative_labels
TAXONOMY_ID_FIELD=id
TAXONOMY_LABEL_FIELD=preferred_label
TAXONOMY_FILTER=type eq 'skill'
TAXONOMY_VECTOR_FIELD=vector
JOBS_VECTOR_FIELD=vector

COSMOS_ENDPOINT=""
COSMOS_DATABASE=""
# Optional: override container names (defaults: jobs, candidates, applications, assessments, llm_cache)
# COSMOS_APPLICATIONS=matches
