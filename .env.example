# Copy to .env (gitignored). Endpoints and deployment names only. NO secrets:
# auth uses DefaultAzureCredential (`az login` locally, managed identity in Azure).
AZURE_OPENAI_ENDPOINT="https://<your-foundry-resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
CHAT_DEPLOYMENT="chat"
EMBEDDING_DEPLOYMENT="embedding"

SEARCH_ENDPOINT="https://<your-search-resource>.search.windows.net"
TAXONOMY_INDEX="taxonomy"
JOBS_INDEX="jobs"
# Fill in after verifying the indexes (README section 5)
# taxonomy.json fields: id, preferred_label, type, definition, alternative_labels, is_deprecated
TAXONOMY_ID_FIELD=id
TAXONOMY_LABEL_FIELD=preferred_label
TAXONOMY_FILTER=type eq 'skill'
TAXONOMY_VECTOR_FIELD=vector
JOBS_VECTOR_FIELD=vector

COSMOS_ENDPOINT="https://<your-cosmos-account>.documents.azure.com:443/"
COSMOS_DATABASE="hidden-talent"
